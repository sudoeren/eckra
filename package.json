{
  "name": "eckra",
  "version": "1.5.1",
  "description": "AI-powered Git management CLI with multi-provider support (OpenAI, Anthropic, OpenRouter, Gemini, DeepSeek, OpenCode Go, Amazon Bedrock, Ollama, LM Studio)",
  "main": "src/index.js",
  "bin": {
    "eckra": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "jest",
    "lint": "eslint src tests && prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint src tests --fix && prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true
  },
  "keywords": [
    "git",
    "cli",
    "ai",
    "commit",
    "lm-studio",
    "openai",
    "anthropic",
    "openrouter",
    "gemini",
    "deepseek",
    "opencode-go",
    "bedrock",
    "ollama",
    "version-control"
  ],
  "author": "Eren",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "boxen": "^4.2.0",
    "chalk": "^4.1.2",
    "commander": "15.0.0",
    "diff": "^7.0.0",
    "eastasianwidth": "^0.3.0",
    "inquirer": "^8.2.6",
    "inquirer-autocomplete-prompt": "^2.0.1",
    "ora": "^9.4.1",
    "simple-git": "^3.36.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sudoeren/eckra"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.2.0",
    "prettier": "^3.9.6"
  }
}
